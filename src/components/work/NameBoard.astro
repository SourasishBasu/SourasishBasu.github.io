---
import { padCells } from '../../lib/flap';

// The split-flap name board. Every tile turns over once on load; after that a
// letter now and then flips to one of the accent colours beside BASU for under
// a second and back, so the name stays readable, and the status row cycles its
// messages. Flips work like real flaps: the top half of the old face falls,
// showing the new face's top half, and lands as the new face's bottom half.
// The U at the end never flips. Stickers appear on hover. Off-screen, in a
// hidden tab or under reduced motion nothing flips.
type Art = 'dither-ink' | 'dither-blue' | 'dither-yellow' | 'dither-eink';
type Sticker = { tile: number; rot: number; art: Art; icon: string; title: string; text: string };

const LETTERS = 'SOURASISHBASU';
const STATUS = 'PLATFORM @ ATLAN';

const stickers: Sticker[] = [
  { tile: 0, rot: -7, art: 'dither-ink', icon: 'layers', title: 'ATLAN', text: 'Platform engineer since June 2025.' },
  { tile: 1, rot: 5, art: 'dither-blue', icon: 'sparkle', title: 'AI-NATIVE', text: 'MCP servers, agent environments, agents in my daily loop.' },
  { tile: 3, rot: 6, art: 'dither-eink', icon: 'face', title: 'PWNAGOTCHI', text: 'Built one on a Raspberry Pi Zero W.' },
  { tile: 5, rot: 4, art: 'dither-yellow', icon: 'mug', title: '3XCAFFEINE', text: 'The hackathon crew. The name checks out.' },
  { tile: 9, rot: -6, art: 'dither-yellow', icon: 'film', title: 'LETTERBOXD', text: '13 films at five stars. City of God is one.' },
  { tile: 10, rot: 5, art: 'dither-blue', icon: 'robot', title: 'GUNPLA', text: 'MG Dynames and MG Virtue built. Vidar is next.' },
];
const byTile = new Map(stickers.map((s) => [s.tile, s]));
const letters = [...LETTERS];
const row1 = letters.slice(0, 9).map((ch, i) => ({ ch, i }));
const row2 = letters.slice(9).map((ch, i) => ({ ch, i: i + 9 }));
const chips = ['chip-blue', 'chip-red', 'chip-yellow', 'chip-white', ''];
const status = padCells(STATUS, 20);
const atlan = stickers[0];
---

<div class="nameplate">
{/* The pinned sticker only shows on phones, where there's no hover. */}
<div class="pinned" aria-hidden="true">
  <span class="sticker static" style={`--r:${atlan.rot + 2}deg`}>
    <span class:list={['st-art', atlan.art]}>
      <svg width="30" height="30" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 5 4 11l12 6 12-6z" /><path d="M4 16l12 6 12-6M4 21l12 6 12-6" /></svg>
    </span>
    <span class="st-cap"><b>{atlan.title}</b>{atlan.text}</span>
  </span>
</div>

<div class="board" aria-hidden="true" data-board>
  {
    [row1, row2].map((row, r) => (
      <div class="row">
        {row.map(({ ch, i }) => {
          const s = byTile.get(i);
          return (
            <span class:list={['tile', { pin: i === 0 }]} data-still={i === letters.length - 1 ? '' : undefined}>
              <span class="glyph" data-letter={ch}>{ch}</span>
              {s && (
                <span class="sticker" data-tile={s.tile} style={`--r:${s.rot}deg`}>
                  <span class:list={['st-art', s.art]}>
                    {s.icon === 'layers' && (
                      <svg width="34" height="34" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 5 4 11l12 6 12-6z" /><path d="M4 16l12 6 12-6M4 21l12 6 12-6" /></svg>
                    )}
                    {s.icon === 'sparkle' && (
                      <svg width="34" height="34" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4c1.2 6.5 3.5 8.8 10 10-6.5 1.2-8.8 3.5-10 10-1.2-6.5-3.5-8.8-10-10 6.5-1.2 8.8-3.5 10-10z" /><path d="M25 20c.5 2.6 1.4 3.5 4 4-2.6.5-3.5 1.4-4 4-.5-2.6-1.4-3.5-4-4 2.6-.5 3.5-1.4 4-4z" /></svg>
                    )}
                    {s.icon === 'face' && <span class="st-face">(◕‿‿◕)</span>}
                    {s.icon === 'mug' && (
                      <svg width="34" height="34" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 12h16v8a6 6 0 0 1-6 6h-4a6 6 0 0 1-6-6z" /><path d="M22 14h2a3 3 0 0 1 0 6h-2" /><path d="M11 4c-1 2 1 3 0 5M16 4c-1 2 1 3 0 5" /></svg>
                    )}
                    {s.icon === 'film' && (
                      <svg width="34" height="34" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="6" width="22" height="20" rx="2" /><path d="M10 6v20M22 6v20M5 11h5M5 16h5M5 21h5M22 11h5M22 16h5M22 21h5" /></svg>
                    )}
                    {s.icon === 'robot' && (
                      <svg width="34" height="34" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="10" y="4" width="12" height="9" rx="2" /><path d="M13 8.5h2M17 8.5h2M16 13v3M9 16h14l-2 7H11zM11 23l-2 5M21 23l2 5M9 16l-4 5M23 16l4 5" /></svg>
                    )}
                  </span>
                  <span class="st-cap"><b>{s.title}</b>{s.text}</span>
                </span>
              )}
            </span>
          );
        })}
        {r === 1 && chips.map((c) => <span class:list={['tile', c]} data-chip={c || undefined} />)}
      </div>
    ))
  }
  <div class="status">
    {status.map((ch) => <span class="flap mini">{ch}</span>)}
  </div>
</div>
<p class="sr-only">{STATUS}</p>
</div>

<style>
  .nameplate {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .board {
    --bp: 16px;
    --bg: 6px;
    --tw: clamp(24px, calc((100cqi - 2 * var(--bp) - 8 * var(--bg)) / 9), 76px);
    --th: calc(var(--tw) * 100 / 76);
    position: relative;
    align-self: flex-start;
    display: inline-flex;
    flex-direction: column;
    gap: var(--bg);
    padding: var(--bp);
    border-radius: 12px;
    background: #141619;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.08),
      0 2px 0 #0b0c0d,
      0 24px 48px -24px rgba(20, 22, 25, 0.65);
  }

  .row {
    display: flex;
    gap: var(--bg);
  }

  .tile {
    position: relative;
    display: grid;
    place-items: center;
    width: var(--tw);
    height: var(--th);
    border-radius: 4px;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.06),
      inset 0 -2px 0 rgba(0, 0, 0, 0.35);
  }

  /* chip tiles take their colour from the global .chip-* classes */
  .tile:not([class*='chip-']) {
    background: var(--flap-face);
  }

  .tile::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 2px;
    margin-top: -1px;
    background: var(--flap-seam);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.05);
  }

  .glyph {
    font-family: var(--font-display);
    font-stretch: 100%;
    font-weight: 500;
    font-size: calc(var(--th) * 0.6);
    line-height: 1;
    color: var(--flap-ink);
  }

  /*
   * A flip in progress (see the script): four half-cards laid over the tile, each a window onto a full-height face
   * (a letter on the flap face, or a colour chip). The two leaves turn on the seam; the seam line stays on top.
   */
  .tile::after,
  .mini::after {
    z-index: 4;
  }

  .board :global(.half) {
    position: absolute;
    left: 0;
    right: 0;
    z-index: 1;
    height: 50%;
    overflow: hidden;
  }

  .board :global(.half.top) {
    top: 0;
    border-radius: inherit;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    transform-origin: 50% 100%;
  }

  .board :global(.half.bottom) {
    bottom: 0;
    border-radius: inherit;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    transform-origin: 50% 0;
  }

  .board :global(.half.leaf.bottom) {
    z-index: 2;
  }

  .board :global(.half.leaf.top) {
    z-index: 3;
  }

  .board :global(.card) {
    position: absolute;
    left: 0;
    right: 0;
    height: 200%;
    display: grid;
    place-items: center;
    color: var(--flap-ink);
  }

  .board :global(.half.top .card) {
    top: 0;
  }

  .board :global(.half.bottom .card) {
    bottom: 0;
  }

  .board :global(.card.plain) {
    background: var(--flap-face);
  }

  .tile :global(.card) {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: calc(var(--th) * 0.6);
    line-height: 1;
  }

  .sticker {
    position: absolute;
    z-index: 10;
    bottom: calc(100% + 10px);
    left: 50%;
    width: 172px;
    padding: 6px;
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    text-align: left;
    background: #fbfbf9;
    box-shadow:
      0 0 0 1px rgba(20, 22, 25, 0.08),
      0 14px 28px -12px rgba(20, 22, 25, 0.45);
    opacity: 0;
    pointer-events: none;
    transform: translateX(-50%) translateY(10px) rotate(var(--r)) scale(0.88);
    transition:
      opacity 0.2s ease,
      transform 0.32s cubic-bezier(0.2, 0.9, 0.25, 1.25);
  }

  .tile:hover .sticker {
    opacity: 1;
    transform: translateX(-50%) translateY(0) rotate(var(--r)) scale(1);
  }

  .st-art {
    height: 74px;
    border-radius: 4px;
    display: grid;
    place-items: center;
  }

  .st-face {
    font: 500 20px/1 var(--font-mono);
  }

  .st-cap {
    padding: 0 4px 4px;
    font: 400 11.5px/1.35 var(--font-sans);
    color: #3a3f45;
  }

  .st-cap b {
    display: block;
    font: 500 10.5px/1.4 var(--font-mono);
    letter-spacing: 0.08em;
    color: #141619;
  }

  .status {
    display: grid;
    grid-template-columns: repeat(20, minmax(0, 1fr));
    gap: 4px;
    margin-top: var(--bg);
    padding-top: 12px;
    border-top: 1px solid #23262a;
  }

  .mini {
    height: calc(var(--th) * 0.46);
    font: 500 calc(var(--th) * 0.25) / 1 var(--font-mono);
  }

  .pinned {
    display: none;
  }

  @media (max-width: 760px) {
    .board {
      --bp: 10px;
      --bg: 4px;
      border-radius: 10px;
    }

    .tile {
      border-radius: 3px;
    }

    .tile .sticker {
      display: none;
    }

    .tile.pin {
      box-shadow: 0 0 0 2px var(--chip-yellow);
    }

    .status {
      grid-template-columns: repeat(10, minmax(0, 1fr));
      gap: 3px;
      padding-top: 8px;
    }

    .mini {
      height: 22px;
      font-size: 11px;
    }

    .pinned {
      display: block;
      position: relative;
      width: 100%;
      height: 96px;
      z-index: 2;
    }

    .sticker.static {
      position: absolute;
      left: 0;
      top: 0;
      bottom: auto;
      width: 150px;
      opacity: 1;
      transform: rotate(var(--r));
    }

    .sticker.static .st-art {
      height: 60px;
    }

    .sticker.static .st-cap {
      font-size: 11px;
    }
  }
</style>

<script>
  import { padCells } from '../../lib/flap';

  /** What a flap shows: a character on the plain flap face, or a colour chip (a chip-* class). */
  type Face = { ch: string; chip: string };

  const board = document.querySelector<HTMLElement>('[data-board]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (board && !reduced.matches) {
    const tiles = [...board.querySelectorAll<HTMLElement>('.tile')].filter((t) => t.querySelector('[data-letter]') && !t.hasAttribute('data-still'));
    const cells = [...board.querySelectorAll<HTMLElement>('.status .mini')];
    // Flips only use the accent colours on the board itself, the chips beside BASU.
    const CHIPS = [...board.querySelectorAll<HTMLElement>('[data-chip]')].map((t) => t.dataset.chip!);
    const MESSAGES = ['PLATFORM @ ATLAN', 'OPEN TO A CHAT'];
    const HALF = 170; // ms for each leaf
    const rand = (lo: number, hi: number) => lo + Math.random() * (hi - lo);
    const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));

    const glyphOf = (tile: HTMLElement) => tile.querySelector<HTMLElement>('[data-letter]')!;
    const letterFace = (tile: HTMLElement): Face => ({ ch: glyphOf(tile).dataset.letter ?? '', chip: '' });
    const setTile = (tile: HTMLElement, face: Face) => {
      tile.classList.remove(...CHIPS);
      if (face.chip) tile.classList.add(face.chip);
      glyphOf(tile).textContent = face.ch;
    };

    const half = (pos: 'top' | 'bottom', face: Face, leaf: boolean) => {
      const el = document.createElement('span');
      el.className = `half ${pos}${leaf ? ' leaf' : ''}`;
      const card = document.createElement('span');
      card.className = `card ${face.chip || 'plain'}`;
      card.textContent = face.ch;
      el.append(card);
      return el;
    };

    /**
     * Turn a flap from one face to another. The new face's top half and the old face's bottom half sit underneath;
     * the old top half falls on the seam (speeding up, as if under gravity), then the new bottom half lands with a
     * small bounce. Each leaf dims a little as it turns edge-on and brightens as it lands. `apply` puts the new face
     * on the flap itself just before the half-cards go.
     */
    const turn = async (el: HTMLElement, from: Face, to: Face, apply: () => void, delay = 0) => {
      const under = [half('top', to, false), half('bottom', from, false)];
      const fall = half('top', from, true);
      const land = half('bottom', to, true);
      el.append(...under, land, fall);
      const p = 'perspective(300px)';
      fall.animate(
        [
          { transform: `${p} rotateX(0deg)`, filter: 'brightness(1)' },
          { transform: `${p} rotateX(-90deg)`, filter: 'brightness(0.78)' },
        ],
        { duration: HALF, delay, easing: 'cubic-bezier(0.55, 0, 1, 0.45)', fill: 'forwards' },
      );
      const landing = land.animate(
        [
          { transform: `${p} rotateX(90deg)`, filter: 'brightness(0.78)' },
          { transform: `${p} rotateX(0deg)`, filter: 'brightness(1)', offset: 0.78 },
          { transform: `${p} rotateX(9deg)`, offset: 0.9 },
          { transform: `${p} rotateX(0deg)`, filter: 'brightness(1)' },
        ],
        { duration: HALF * 1.35, delay: delay + HALF, easing: 'cubic-bezier(0, 0.55, 0.45, 1)', fill: 'both' },
      );
      await landing.finished;
      apply();
      for (const h of [...under, land, fall]) h.remove();
    };

    let visible = false;
    let started = false;
    let lastTile = -1;
    let msg = 0;
    const busy = new Set<HTMLElement>();

    // One flip: a letter turns over to an accent colour, holds for under a second, and turns back to the letter.
    const flipOne = async () => {
      if (busy.size >= 2) return;
      const free = tiles.map((_, i) => i).filter((i) => !busy.has(tiles[i]) && i !== lastTile);
      const i = free[Math.floor(Math.random() * free.length)];
      if (i === undefined) return;
      lastTile = i;
      const tile = tiles[i];
      const letter = letterFace(tile);
      const chip = { ch: '', chip: CHIPS[Math.floor(Math.random() * CHIPS.length)] };
      busy.add(tile);
      await turn(tile, letter, chip, () => setTile(tile, chip));
      await wait(rand(650, 950));
      await turn(tile, chip, letter, () => setTile(tile, letter));
      busy.delete(tile);
    };

    /** A full turn back to the same letter: the load-in cascade and the hover flick. */
    const turnOver = async (tile: HTMLElement, delay = 0) => {
      if (busy.has(tile)) return;
      busy.add(tile);
      const letter = letterFace(tile);
      await turn(tile, letter, letter, () => setTile(tile, letter), delay);
      busy.delete(tile);
    };

    tiles.forEach((tile) =>
      tile.addEventListener('pointerenter', (e) => {
        if (e.pointerType === 'mouse' && started) turnOver(tile);
      }),
    );

    const loopFlips = () => {
      setTimeout(() => {
        if (visible && !document.hidden) flipOne();
        loopFlips();
      }, rand(3500, 8000));
    };

    // The status row: only cells whose character changes turn, left to right.
    const showMessage = (text: string, start = 0) => {
      padCells(text, cells.length).forEach((ch, k) => {
        const cell = cells[k];
        const was = cell.textContent ?? '';
        if (was === ch) return;
        turn(cell, { ch: was, chip: '' }, { ch, chip: '' }, () => (cell.textContent = ch), start + k * 32);
      });
    };
    const nextMessage = () => {
      if (visible && !document.hidden) {
        msg = (msg + 1) % MESSAGES.length;
        showMessage(MESSAGES[msg]);
      }
      setTimeout(nextMessage, 3600);
    };

    new IntersectionObserver(([entry]) => {
      visible = !!entry?.isIntersecting;
      if (visible && !started) {
        started = true;
        // Every tile turns over once, left to right.
        tiles.forEach((t, k) => turnOver(t, k * 45));
        loopFlips();
        setTimeout(nextMessage, 3600);
      }
    }).observe(board);
  }
</script>
