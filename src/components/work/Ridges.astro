---
import { ridgePath, RIDGE_W, RIDGE_H, RIDGE_LAYERS } from '../../lib/ridges';

// Dot patterns for the seven layers, back (light, sparse) to front (dark, dense).
const dots = [
  { r: 0.55, fill: '#9FB2D9', bg: '#FBFBF9' },
  { r: 0.72, fill: '#86A0D1', bg: '#FBFBF9' },
  { r: 0.9, fill: '#6B88C4', bg: '#FBFBF9' },
  { r: 1.08, fill: '#4F6FB5', bg: '#FBFBF9' },
  { r: 1.26, fill: '#3A5AA6', bg: '#FBFBF9' },
  { r: 1.45, fill: '#2A4790', bg: '#FBFBF9' },
  { r: 1.62, fill: '#1C3576', bg: '#E9ECF4' },
];
const layers = Array.from({ length: RIDGE_LAYERS }, (_, i) => ridgePath(i));
const birds = [
  { top: 34, delay: -6, dur: 46, size: 9 },
  { top: 46, delay: -9, dur: 49, size: 8 },
  { top: 62, delay: -21, dur: 52, size: 7 },
  { top: 22, delay: -33, dur: 40, size: 10 },
  { top: 30, delay: -36, dur: 43, size: 8 },
];
---

<section class="band scene" aria-hidden="true">
  <svg width="100%" height={RIDGE_H} viewBox={`0 0 ${RIDGE_W} ${RIDGE_H}`} preserveAspectRatio="xMidYMax slice">
    <defs>
      {
        dots.map((d, i) => (
          <pattern id={`d${i}`} width="4" height="4" patternUnits="userSpaceOnUse">
            <rect width="4" height="4" fill={d.bg} />
            <circle cx="2" cy="2" r={d.r} fill={d.fill} />
          </pattern>
        ))
      }
    </defs>
    {layers.map((d, i) => <path d={d} fill={`url(#d${i})`} />)}
  </svg>
  <div class="birds">
    {
      birds.map((b) => (
        <span class="bird" style={`top:${b.top}px;animation-delay:${b.delay}s;animation-duration:${b.dur}s`}>
          <span class="bird-in" style={`font-size:${b.size}px`}>
            <span class="w1">\_v_/</span>
            <span class="w2">_/v\_</span>
          </span>
        </span>
      ))
    }
  </div>
</section>

<style>
  .scene {
    height: 280px;
    overflow: hidden;
  }

  .birds {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .bird {
    position: absolute;
    left: -12%;
    animation: drift 46s linear infinite;
  }

  .bird-in {
    display: block;
    font: 500 9px/1 var(--font-mono);
    color: #1f3b7d;
    white-space: pre;
  }

  .w1,
  .w2 {
    display: inline-block;
  }

  .w1 {
    animation: wing-a 0.7s steps(1) infinite;
  }

  .w2 {
    margin-left: -5ch;
    animation: wing-b 0.7s steps(1) infinite;
  }

  @keyframes wing-a {
    0% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }

  @keyframes wing-b {
    0% {
      opacity: 0;
    }
    50% {
      opacity: 1;
    }
  }

  @keyframes drift {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(1500px);
    }
  }

  /* reduced motion: keep the flock parked mid-sky with wings up */
  @media (prefers-reduced-motion: reduce) {
    .bird:nth-child(1) {
      left: 22%;
    }
    .bird:nth-child(2) {
      left: 30%;
    }
    .bird:nth-child(3) {
      left: 61%;
    }
    .bird:nth-child(4) {
      left: 74%;
    }
    .bird:nth-child(5) {
      left: 80%;
    }

    .w2 {
      opacity: 0;
    }
  }
</style>
