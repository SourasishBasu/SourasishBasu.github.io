---
import { jobs } from '../../data/experience';

// Tabs: Atlan is selected in the HTML; the script below switches panels on
// click and with the arrow keys, Home and End. On phones there are no tabs:
// both companies are shown one after the other (Phone.dc.html).
const selected = 'atlan';
const dither = { cost: 'dither-yellow', dash: 'dither-blue', alert: 'dither-red' } as const;
---

<section class="band xp">
  <div class="xp-side">
    <span class="eyebrow">Work experience</span>
    <h2 class="display h2">Where I've worked</h2>
    <div role="tablist" aria-label="Where I've worked" aria-orientation="vertical" class="xp-tabs">
      {
        jobs.map((j) => (
          <button
            type="button"
            role="tab"
            id={`tab-${j.id}`}
            aria-controls={j.id}
            aria-selected={j.id === selected ? 'true' : 'false'}
            tabindex={j.id === selected ? 0 : -1}
            class:list={['xbtn', { sel: j.id === selected }]}
          >
            <span class:list={['logo logo-sm', { 'has-img': j.logo, framed: j.logoFramed }]}>{j.logo ? <img src={j.logo} alt="" width="36" height="36" /> : j.initials}</span>
            <span class="xbtn-text">
              <span class="xbtn-name">{j.company}</span>
              <span class="mono xbtn-meta">{j.short}</span>
            </span>
          </button>
        ))
      }
    </div>
  </div>

  <div class="xp-detail vline">
    {
      jobs.map((j) => (
        <article id={j.id} role="tabpanel" aria-labelledby={`tab-${j.id}`} hidden={j.id !== selected} class="panel">
          <div class:list={['head', { 'head--tight': !!j.summary }]}>
            <div class="who">
              <span class:list={['logo logo-lg', { 'has-img': j.logo, framed: j.logoFramed }]}>{j.logo ? <img src={j.logo} alt={`${j.company} logo`} width="56" height="56" /> : j.initials}</span>
              <div class="who-text">
                <h3 class="display company">{j.company}</h3>
                <span class="role">{j.role}</span>
              </div>
            </div>
            <span class="mono when">
              {j.when} · {j.where}
            </span>
          </div>

          {j.summary && <p class="summary">{j.summary}</p>}

          {j.cells && (
            <div class="cells">
              {j.cells.map((c) => (
                <div class="fcell">
                  <span class:list={['ico', dither[c.icon]]}>
                    {c.icon === 'cost' && (
                      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="10" cy="10" r="7" /><path d="M10 6v8M12.5 7.5H9a1.5 1.5 0 0 0 0 3h2a1.5 1.5 0 0 1 0 3H7.5" /></svg>
                    )}
                    {c.icon === 'dash' && (
                      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="14" height="14" rx="2" /><path d="M6 13l3-3 2 2 3-4" /></svg>
                    )}
                    {c.icon === 'alert' && (
                      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M10 3a5 5 0 0 0-5 5v3l-1.5 3h13L15 11V8a5 5 0 0 0-5-5zM8 16a2 2 0 0 0 4 0" /></svg>
                    )}
                  </span>
                  <h4>{c.title}</h4>
                  <p>{c.body}</p>
                </div>
              ))}
            </div>
          )}

          <div class="metrics">
            {j.metrics.map((m) => (
              <div class="fcell mcell">
                <span class="flap-row" aria-hidden="true">
                  {[...m.cells].map((ch) => (
                    <span class="flap flap--mini">{ch}</span>
                  ))}
                </span>
                <span class="sr-only">{m.cells}</span>
                <p>{m.label}</p>
              </div>
            ))}
          </div>

          {j.tags && (
            <div class="tags">
              {j.tags.map((t) => (
                <span class="tag">{t}</span>
              ))}
            </div>
          )}
        </article>
      ))
    }
  </div>
  <span class="cross cl"></span><span class="cross cr"></span>
</section>

<script>
  const list = document.querySelector<HTMLElement>('.xp [role="tablist"]');
  if (list) {
    const tabs = [...list.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const select = (tab: HTMLButtonElement, focus = false) => {
      for (const t of tabs) {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        t.classList.toggle('sel', on);
        const panel = document.getElementById(t.getAttribute('aria-controls') ?? '');
        if (panel) panel.hidden = !on;
      }
      if (focus) tab.focus();
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (e) => {
        const last = tabs.length - 1;
        const to = { ArrowDown: i + 1, ArrowRight: i + 1, ArrowUp: i - 1, ArrowLeft: i - 1, Home: 0, End: last }[e.key];
        if (to === undefined) return;
        e.preventDefault();
        select(tabs[(to + tabs.length) % tabs.length], true);
      });
    });
  }
</script>

<style>
  .xp {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
  }

  .xp-side {
    padding: 64px 40px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .xp-tabs {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-top: 12px;
  }

  .xbtn {
    all: unset;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    gap: 14px;
    width: 100%;
    padding: 12px;
    border-radius: 10px;
    color: var(--ink);
    cursor: pointer;
    transition: background-color 0.2s;
  }

  .xbtn:hover {
    background: var(--tint-hover);
  }

  .xbtn.sel {
    background: var(--tint);
    box-shadow: inset 3px 0 0 var(--ink);
  }

  .xbtn:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 1px;
  }

  .xbtn-text {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }

  .xbtn-name {
    font: 500 15.5px/1.2 var(--font-sans);
  }

  .xbtn-meta {
    font-size: 11.5px;
    color: var(--graphite);
  }

  .logo {
    display: inline-grid;
    place-items: center;
    flex-shrink: 0;
    border-radius: 9px;
    background: repeating-linear-gradient(45deg, #eef0ec 0 4px, #f8f8f5 4px 8px);
    box-shadow: inset 0 0 0 1px var(--rail);
    font: 600 12.5px/1 var(--font-mono);
    color: var(--graphite);
  }

  .logo.has-img {
    overflow: hidden;
    background: var(--paper);
  }

  .logo img {
    display: block;
    width: 78%;
    height: 78%;
    object-fit: contain;
  }

  .logo.framed img {
    width: 100%;
    height: 100%;
  }

  .logo-sm {
    width: 36px;
    height: 36px;
  }

  .logo-lg {
    width: 56px;
    height: 56px;
    font-size: 16px;
  }

  .xp-detail {
    display: flex;
    flex-direction: column;
  }

  .head {
    padding: 64px 32px 28px;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px;
    flex-wrap: wrap;
  }

  .head--tight {
    padding-bottom: 24px;
  }

  .who {
    display: flex;
    align-items: center;
    gap: 16px;
    min-width: 0;
  }

  .who-text {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }

  .company {
    margin: 0;
    font-size: 30px;
    font-stretch: 112%;
  }

  .role {
    font-size: 16px;
    color: var(--ink-2);
  }

  .when {
    font-size: 12.5px;
    color: var(--graphite);
  }

  .summary {
    margin: 0;
    max-width: 680px;
    padding: 0 32px 28px;
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--ink-muted);
  }

  .cells {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--rule);
  }

  .metrics {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--rule);
  }

  .fcell {
    padding: 22px 22px 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .fcell + .fcell {
    border-left: 1px solid var(--rule);
  }

  .fcell h4 {
    margin: 0;
    font: 600 15px/1.3 var(--font-sans);
  }

  .fcell p {
    margin: 0;
    font: 400 14.5px/1.55 var(--font-sans);
    color: var(--ink-muted);
  }

  .ico {
    display: inline-grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 7px;
    background-size:
      4px 4px,
      100% 100%;
  }

  .mcell:hover .flap {
    animation: flick 0.38s ease;
  }

  .mcell:hover .flap:nth-child(2) {
    animation-delay: 0.05s;
  }

  .mcell:hover .flap:nth-child(3) {
    animation-delay: 0.1s;
  }

  .mcell:hover .flap:nth-child(4) {
    animation-delay: 0.15s;
  }

  .mcell:hover .flap:nth-child(5) {
    animation-delay: 0.2s;
  }

  .tags {
    padding: 18px 32px 28px;
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    border-top: 1px solid var(--rule);
  }

  /* tablet: switcher as a row above a full-width detail */
  @media (max-width: 1023px) {
    .xp {
      grid-template-columns: minmax(0, 1fr);
    }

    .xp-side {
      padding: 56px 40px 24px;
    }

    .xp-tabs {
      flex-direction: row;
      margin-top: 8px;
    }

    .xbtn {
      flex: 1 1 0;
      min-width: 0;
    }

    .xbtn.sel {
      box-shadow: inset 0 -3px 0 var(--ink);
    }

    .xp-detail {
      border-left: 0;
      border-top: 1px solid var(--rule);
    }

    .head {
      padding-top: 32px;
    }

    .metrics {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .metrics .fcell:nth-child(3) {
      border-left: 0;
    }

    .metrics .fcell:nth-child(n + 3) {
      border-top: 1px solid var(--rule);
    }
  }

  /* phone: no tabs, both companies stacked (Phone.dc.html) */
  @media (max-width: 760px) {
    .xp-side {
      padding: 32px 16px 8px;
      gap: 8px;
    }

    .xp-tabs {
      display: none;
    }

    .xp-detail {
      border-top: 0;
    }

    .panel[hidden] {
      display: block;
    }

    .panel + .panel {
      border-top: 1px solid var(--rail);
    }

    .head {
      padding: 20px 16px 16px;
    }

    .head--tight {
      padding-top: 28px;
    }

    .logo-lg {
      width: 44px;
      height: 44px;
      font-size: 14px;
    }

    .company {
      font-size: 22px;
    }

    .role {
      font-size: 14.5px;
    }

    .when {
      font-size: 11.5px;
    }

    .summary {
      padding: 0 16px 20px;
      font-size: 14.5px;
      line-height: 1.55;
    }

    .cells {
      grid-template-columns: minmax(0, 1fr);
    }

    .cells .fcell + .fcell {
      border-left: 0;
      border-top: 1px solid var(--rule);
    }

    .fcell {
      padding: 16px;
      gap: 8px;
    }

    .cells .ico {
      display: none;
    }

    .fcell p {
      font-size: 13.5px;
      line-height: 1.5;
    }

    .tags {
      padding: 16px 16px 24px;
    }
  }
</style>
