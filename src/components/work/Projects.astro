---
import { projects } from '../../data/projects';

// Static in phase 2: the first project is selected. Phase 4 adds selection on
// hover, focus and click, swapping the spec sheet.
const sel = projects[0];
---

<section id="projects" class="band projects">
  <div class="pj-head">
    <div class="pj-title">
      <span class="eyebrow">Selected projects</span>
      <h2 class="display h2">Things I've built</h2>
    </div>
    <p class="lead pj-note">Dated from my first and last commits.</p>
  </div>

  <div class="pj-body">
    <div class="rows">
      {
        projects.map((p) => (
          <button type="button" class:list={['prow', { sel: p.id === sel.id }]} aria-pressed={p.id === sel.id ? 'true' : 'false'} aria-controls="project-spec">
            <span class="prow-text">
              <span class="pname">{p.name}</span>
              <span class="pwhat">{p.what}</span>
            </span>
            <span class="pkind">{p.kind}</span>
            <svg class="arrow" aria-hidden="true" width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4" /></svg>
          </button>
        ))
      }
    </div>

    <aside class="spec-wrap" aria-label="Selected project">
      <div class="spec" id="project-spec">
        <pre class="art term">{sel.term}</pre>
        <div class="spec-body">
          <div class="spec-meta">
            <span class="mono spec-when">{sel.when}</span>
            <span class="tag tag--sm">{sel.team}</span>
          </div>
          <h3 class="display spec-name">{sel.name}</h3>
          <p class="spec-detail">{sel.detail}</p>
          <div class="spec-stack">
            {sel.stack.map((s) => <span class="tag">{s}</span>)}
          </div>
          <div class="spec-hl">
            <span class="eyebrow">Highlight</span>
            <span>{sel.highlight}</span>
          </div>
          <a class="spec-link" href={sel.link}>Open the repository ↗</a>
        </div>
      </div>
    </aside>
  </div>
  <span class="cross cl"></span><span class="cross cr"></span>
</section>

<style>
  .projects {
    padding: 64px 40px 72px;
  }

  .pj-head {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 24px;
    align-items: end;
    margin-bottom: 28px;
  }

  .pj-title {
    grid-column: span 7;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .pj-note {
    grid-column: span 5;
  }

  .pj-body {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 32px;
    align-items: start;
  }

  .rows {
    grid-column: span 7;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .prow {
    all: unset;
    box-sizing: border-box;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto 28px;
    gap: 18px;
    align-items: center;
    width: 100%;
    padding: 18px 16px 18px 12px;
    border-radius: 10px;
    font-family: var(--font-sans);
    color: var(--ink);
    cursor: pointer;
  }

  .prow:hover,
  .prow.sel {
    background: var(--tint);
  }

  .prow:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 1px;
  }

  .prow-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .pname {
    font: 500 17px/1.3 var(--font-sans);
  }

  .pwhat {
    margin-top: 3px;
    font: 400 14px/1.45 var(--font-sans);
    color: var(--ink-muted);
  }

  .pkind {
    font: 500 11px/1 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--graphite);
    white-space: nowrap;
  }

  .arrow {
    opacity: 0;
    transform: translateX(-4px);
    transition:
      opacity 0.2s,
      transform 0.2s;
  }

  .prow.sel .arrow {
    opacity: 1;
    transform: none;
  }

  .spec-wrap {
    grid-column: span 5;
    align-self: stretch;
  }

  .spec {
    position: sticky;
    top: 80px;
    border-radius: 12px;
    background: var(--paper);
    box-shadow:
      0 0 0 1px var(--rail),
      0 18px 36px -24px rgba(20, 22, 25, 0.35);
    overflow: hidden;
  }

  .art {
    height: 268px;
    margin: 0;
    border-bottom: 1px solid var(--rule);
    overflow: hidden;
  }

  .term {
    padding: 16px 20px;
    background: #141619;
    color: #d8e0d4;
    font: 400 12.5px/1.55 var(--font-mono);
    white-space: pre;
  }

  .spec-body {
    padding: 20px 22px 22px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .spec-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .spec-when {
    font-size: 12px;
    color: var(--graphite);
  }

  .spec-name {
    margin: 0;
    font-size: 26px;
    font-stretch: 112%;
    line-height: 1.15;
  }

  .spec-detail {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink-2);
  }

  .spec-stack {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  .spec-hl {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-top: 12px;
    border-top: 1px solid #e2e5e0;
    font-size: 14.5px;
    line-height: 1.5;
    color: var(--ink-muted);
  }

  .spec-hl .eyebrow {
    font-size: 10.5px;
  }

  .spec-link {
    align-self: flex-start;
    font: 500 14px/1 var(--font-sans);
    text-decoration: none;
  }

  /* tablet and phone: list above a static spec sheet */
  @media (max-width: 1023px) {
    .pj-body {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }

    .rows,
    .spec-wrap {
      grid-column: 1 / -1;
    }

    .spec {
      position: static;
    }
  }

  @media (max-width: 760px) {
    .projects {
      padding: 32px 16px 40px;
    }

    .pj-head {
      grid-template-columns: minmax(0, 1fr);
      gap: 10px;
      margin-bottom: 18px;
    }

    .pj-title,
    .pj-note {
      grid-column: 1 / -1;
    }

    .pj-title {
      gap: 8px;
    }

    .prow {
      grid-template-columns: minmax(0, 1fr);
      gap: 8px;
      padding: 14px 12px;
    }

    .pkind {
      order: -1;
      font-size: 10.5px;
    }

    .arrow {
      display: none;
    }

    .pname {
      font-size: 16px;
    }

    .pwhat {
      font-size: 13.5px;
    }

    .art {
      height: 240px;
    }

    .term {
      padding: 14px 16px;
      font-size: 11.5px;
    }

    .spec-body {
      padding: 18px 16px 20px;
    }

    .spec-name {
      font-size: 22px;
    }

    .spec-detail {
      font-size: 14.5px;
    }
  }
</style>
