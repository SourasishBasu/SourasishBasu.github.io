---
// The 404's footer pet: Sasquatch hunting for the missing page. Its eyes follow the pointer, it perks up when you
// hover it, dozes off when left alone, and sulks when poked.
---

<div class="pcb" data-lost-pet role="img" aria-label="Sasquatch the e-ink pet, looking for the page">
  <span class="hole" style="left:8px;top:8px"></span>
  <span class="hole" style="right:8px;top:8px"></span>
  <span class="hole" style="left:8px;bottom:8px"></span>
  <span class="hole" style="right:8px;bottom:8px"></span>
  <span class="silk">SQ-404 rev B</span>
  <span class="eink">
    <span class="eink-top"><span>SASQUATCH</span><span data-mood>SEARCHING</span></span>
    <span class="face" data-face>( ⚆_⚆)</span>
    <span class="eink-line"><span data-line>&gt;</span><span class="caret">_</span></span>
  </span>
</div>

<style>
  .pcb {
    position: relative;
    width: min(360px, 100%);
    padding: 20px 20px 30px;
    border-radius: 12px;
    background-color: #22513c;
    background-image: radial-gradient(circle, rgba(255, 255, 255, 0.06) 1px, transparent 1.3px);
    background-size: 8px 8px;
    cursor: pointer;
    user-select: none;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.1),
      0 2px 0 #0f2a1e,
      0 20px 40px -22px rgba(0, 0, 0, 0.8);
  }

  .hole {
    position: absolute;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--hole-bg);
    box-shadow:
      inset 0 1px 2px rgba(0, 0, 0, 0.45),
      0 0 0 3px #c9a64a;
  }

  .silk {
    position: absolute;
    right: 24px;
    bottom: 10px;
    font: 500 9px/1 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(236, 234, 228, 0.55);
  }

  .eink {
    display: block;
    padding: 10px 12px;
    border-radius: 4px;
    background-color: #dcded4;
    background-image: radial-gradient(circle, rgba(20, 22, 25, 0.06) 1px, transparent 1.2px);
    background-size: 3px 3px;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.2);
    color: #16181a;
    font-family: var(--font-mono);
  }

  .eink-top {
    display: flex;
    justify-content: space-between;
    padding-bottom: 6px;
    border-bottom: 1px solid #16181a;
    font-size: 10px;
    letter-spacing: 0.06em;
  }

  .face {
    display: block;
    padding: 20px 0 16px;
    font: 500 46px/1 var(--font-mono);
    letter-spacing: -0.02em;
    text-align: center;
    white-space: pre;
  }

  .eink-line {
    display: block;
    min-height: 1.4em;
    padding-top: 6px;
    border-top: 1px solid #16181a;
    font-size: 11.5px;
    white-space: pre;
    overflow: hidden;
  }

  .caret {
    animation: blink 1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .caret {
      animation: none;
    }
  }

  @media (max-width: 1023px) {
    .pcb {
      width: 100%;
      padding: 14px 14px 26px;
    }

    .face {
      font-size: 36px;
      padding: 14px 0 12px;
    }
  }
</style>

<script>
  import { FACES, screen } from '../pet/eink';

  const pet = document.querySelector<HTMLElement>('[data-lost-pet]');
  if (pet) {
    const path = decodeURI(location.pathname);
    const short = path.length > 24 ? `${path.slice(0, 23)}…` : path;
    const s = screen(pet, 'SEARCHING');
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const now = () => performance.now();

    // Searching: eyes dart left and right while the log runs.
    const LOG = [`> GET ${short}`, '> 404: not on this board', '> sniffing the logs…', '> try the work tab?'];
    let step = 0;
    let lastPointer = now();
    let hovering = false;
    let sulking = 0;

    if (reduced) {
      s.look(FACES.lookRight);
      s.say(`> GET ${short} → 404`);
    } else {
      s.say(LOG[0]);
      setInterval(() => {
        if (document.hidden || hovering || now() < sulking) return;
        const idle = now() - lastPointer;
        if (idle > 9000) {
          if (s.mood !== 'ASLEEP') s.become('ASLEEP', FACES.sleep, '> zzz… (move to wake)');
          return;
        }
        if (s.mood !== 'SEARCHING') s.become('SEARCHING', FACES.lookRight, LOG[(step = (step + 1) % LOG.length)]);
        else if (idle > 2500) {
          s.look(pet.querySelector('[data-face]')!.textContent === FACES.lookRight ? FACES.lookLeft : FACES.lookRight);
          if (Math.random() < 0.35) s.say(LOG[(step = (step + 1) % LOG.length)]);
        }
      }, 1100);

      window.addEventListener(
        'pointermove',
        (e) => {
          const wasAsleep = s.mood === 'ASLEEP';
          lastPointer = now();
          if (hovering || now() < sulking) return;
          if (wasAsleep) return s.become('STARTLED', FACES.shock, '> !! huh? still looking');
          const r = pet.getBoundingClientRect();
          if (s.mood === 'STARTLED' || s.mood === 'SEARCHING') s.look(e.clientX < r.left + r.width / 2 ? FACES.lookLeft : FACES.lookRight);
        },
        { passive: true },
      );
      pet.addEventListener('pointerenter', () => {
        hovering = true;
        s.become('HAPPY', FACES.awake, '> oh, hi. you lost too?');
      });
      pet.addEventListener('pointerleave', () => {
        hovering = false;
        s.become('SEARCHING', FACES.lookRight, LOG[step]);
      });
      pet.addEventListener('click', () => {
        sulking = now() + 2600;
        s.become('SAD', FACES.sad, '> hey. i looked everywhere');
        setTimeout(() => s.become(hovering ? 'HAPPY' : 'SEARCHING', hovering ? FACES.awake : FACES.lookRight, hovering ? '> ok, back to it' : LOG[step]), 2600);
      });
    }
  }
</script>
