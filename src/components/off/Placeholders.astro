---
// Phase 1 skeleton of the Off the clock page. Phase 3 fills in the mini board,
// the CD player, the kit list and the viewer stage; phase 4 adds the dust canvas.
---

<section class="band hero">
  <div class="glow" aria-hidden="true"></div>
  <div class="rays" aria-hidden="true"></div>
  <div class="hero-main">
    <span class="eyebrow">Off the clock</span>
    <h1 class="display h1">Away from the terminal</h1>
    <p class="muted">Work is only part of it. This is what I'm into once I log off.</p>
  </div>
  <div class="hero-side vline"></div>
  <span class="cross cl"></span><span class="cross cr"></span>
</section>

<section class="band films">
  <div class="intro">
    <span class="eyebrow">Films</span>
    <h2 class="display h2">I watch a lot of films</h2>
    <p class="muted">Every one gets logged and rated on Letterboxd. Spin through the ones that got five stars.</p>
  </div>
  <div class="vline">
    <div class="player" aria-hidden="true"></div>
  </div>
  <span class="cross cl"></span><span class="cross cr"></span>
</section>

<section class="band gunpla">
  <div>
    <div class="bench" aria-hidden="true"></div>
  </div>
  <div class="intro vline">
    <span class="eyebrow">Gunpla</span>
    <h2 class="display h2">Kits I've built</h2>
    <p class="muted">Master Grades, mostly. The finished ones are on my shelf, the rest are next in line.</p>
  </div>
  <span class="cross cl"></span><span class="cross cr"></span>
</section>

<style>
  .muted {
    margin: 0;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.6;
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    overflow: hidden;
  }

  .glow {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 560px;
    pointer-events: none;
    background:
      radial-gradient(34% 26% at 50% 0%, rgba(236, 232, 255, 0.32), rgba(236, 232, 255, 0) 70%),
      radial-gradient(70% 62% at 50% -6%, rgba(176, 164, 255, 0.5), rgba(139, 124, 246, 0.28) 32%, rgba(88, 74, 190, 0.12) 56%, rgba(16, 18, 21, 0) 78%);
  }

  .rays {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 420px;
    pointer-events: none;
    opacity: 0.5;
    background: repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.03) 0 1px, transparent 1px 7px);
    -webkit-mask-image: radial-gradient(60% 80% at 50% 0%, #000, transparent 75%);
    mask-image: radial-gradient(60% 80% at 50% 0%, #000, transparent 75%);
  }

  .hero-main {
    position: relative;
    padding: 220px 40px 64px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .hero-main .muted {
    max-width: 520px;
    font-size: 18px;
  }

  .h1 {
    margin: 0;
    max-width: 720px;
    font-size: 60px;
    line-height: 1.04;
  }

  .hero-side {
    position: relative;
  }

  .films {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
  }

  .gunpla {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
  }

  .intro {
    padding: 64px 40px;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .intro .muted {
    max-width: 420px;
  }

  .player {
    height: 540px;
    background: radial-gradient(60% 60% at 50% 42%, #1c1f25, #0b0c0e 75%);
  }

  .bench {
    height: 520px;
    background-color: #22684b;
    background-image:
      linear-gradient(rgba(240, 248, 222, 0.62) 1.5px, transparent 1.5px),
      linear-gradient(90deg, rgba(240, 248, 222, 0.62) 1.5px, transparent 1.5px),
      linear-gradient(rgba(240, 248, 222, 0.3) 1px, transparent 1px),
      linear-gradient(90deg, rgba(240, 248, 222, 0.3) 1px, transparent 1px),
      linear-gradient(rgba(240, 248, 222, 0.1) 1px, transparent 1px),
      linear-gradient(90deg, rgba(240, 248, 222, 0.1) 1px, transparent 1px);
    background-size:
      110px 110px,
      110px 110px,
      22px 22px,
      22px 22px,
      11px 11px,
      11px 11px;
    background-position: 30px 30px;
    box-shadow:
      inset 0 0 0 1px rgba(0, 0, 0, 0.3),
      inset 0 0 80px rgba(0, 0, 0, 0.25);
  }

  @media (max-width: 1023px) {
    .hero,
    .films,
    .gunpla {
      grid-template-columns: minmax(0, 1fr);
    }

    .hero-side {
      display: none;
    }

    .vline {
      border-left: 0;
    }

    .gunpla .intro {
      order: -1;
      padding-bottom: 32px;
    }

    .films .intro {
      padding-bottom: 32px;
    }
  }

  @media (max-width: 760px) {
    .hero-main {
      padding: 140px 16px 48px;
    }

    .h1 {
      font-size: 34px;
    }

    .intro {
      padding: 40px 16px 28px;
    }

    .player {
      height: 360px;
    }

    .bench {
      height: 380px;
    }
  }
</style>
