---
import { kits } from '../../data/kits';

// The bench: a green cutting mat with rulers and a turntable. The Dynames is a 3D model, loaded only when
// the section comes near the screen; the other kits are cut-out, cel-shaded halftone pictures standing on the
// turntable. The kit list on the right is a set of tabs; each one shows its kit on the bench and its details below.
const first = kits[0];
---

<section class="band gunpla" data-gunpla>
  <div class="stage">
    <div class="bench" data-bench>
      <span class="lamp" aria-hidden="true"></span>
      <div class="stand" data-stand>
        <span class="disc" aria-hidden="true"><span class="plane"><span class="ticks"></span></span></span>
        {
          kits
            .filter((k) => k.art)
            .map((k) => (
              <img
                class:list={['kit-art', { next: !k.built }]}
                data-art={k.id}
                src={k.art!.src}
                width={k.art!.width}
                height={k.art!.height}
                alt={`${k.name}, drawn in halftone`}
                loading="lazy"
                decoding="async"
                hidden={k.id !== first.id}
              />
            ))
        }
      </div>
      <canvas class="model" data-model role="img" aria-label="Gundam Dynames, a 3D model turning on the bench. Drag sideways to turn it; pinch or double-click to zoom."
      ></canvas>
      <div class="mruler top" aria-hidden="true"></div>
      <div class="mruler left" aria-hidden="true"></div>
    </div>
    {
      kits.map((k) => (
        <div class="card" role="tabpanel" id={`kit-${k.id}`} aria-labelledby={`kit-tab-${k.id}`} hidden={k.id !== first.id}>
          <div class="card-head">
            <div class="card-title">
              <span class="code">{k.code}</span>
              <span class="display name">{k.name}</span>
            </div>
            <span class:list={['pill', k.built ? 'p-built' : 'p-next']}>{k.built ? 'Built' : 'Up next'}</span>
          </div>
          <div>
            <div class="eyebrow">Grade</div>
            <div class="val">{k.grade}</div>
          </div>
          <div>
            <div class="eyebrow">Series</div>
            <div class="val">{k.series}</div>
          </div>
          <div>
            <div class="eyebrow">{k.whenLabel}</div>
            <div class="val">{k.when}</div>
          </div>
        </div>
      ))
    }
  </div>
  <div class="intro vline">
    <span class="eyebrow">Gunpla</span>
    <h2 class="display h2">Kits I've built</h2>
    <p class="muted">Master Grades, mostly. The finished ones are on my shelf, the rest are next in line.</p>
    <div class="kits" role="tablist" aria-label="Kits" aria-orientation="vertical">
      {
        kits.map((k) => (
          <button
            type="button"
            role="tab"
            id={`kit-tab-${k.id}`}
            class:list={['krow', { sel: k.id === first.id }]}
            aria-selected={k.id === first.id ? 'true' : 'false'}
            aria-controls={`kit-${k.id}`}
            tabindex={k.id === first.id ? 0 : -1}
            data-kit={k.id}
            data-built={k.built ? '' : undefined}
            data-has-model={k.model ? '' : undefined}
          >
            <span class="ktext">
              <span class="kname">{k.name}</span>
              <span class="kmeta">
                {k.code} · {k.grade}
              </span>
            </span>
            <span class:list={['kkind', k.built ? 'built' : 'next']}>{k.built ? 'Built' : 'Up next'}</span>
            <svg class="arrow" aria-hidden="true" width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4" /></svg>
          </button>
        ))
      }
    </div>
  </div>
  <span class="cross cl"></span><span class="cross cr"></span>
</section>

<script>
  import type { BenchViewer } from './gunpla/viewer';

  const root = document.querySelector<HTMLElement>('[data-gunpla]');
  const bench = root?.querySelector<HTMLElement>('[data-bench]');
  const stand = root?.querySelector<HTMLElement>('[data-stand]');
  const canvas = root?.querySelector<HTMLCanvasElement>('[data-model]');
  const list = root?.querySelector<HTMLElement>('[role="tablist"]');

  if (root && bench && stand && canvas && list) {
    const tabs = [...list.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let viewer: BenchViewer | null = null;
    let current = tabs.find((t) => t.getAttribute('aria-selected') === 'true') ?? tabs[0];
    let onScreen = false;

    // Show the selected kit on the bench: the 3D model once it's ready, or the kit's picture.
    const arts = [...stand.querySelectorAll<HTMLImageElement>('[data-art]')];
    const show = () => {
      const model = current.dataset.hasModel !== undefined && viewer !== null;
      root.dataset.view = model ? 'model' : 'figure';
      for (const img of arts) img.hidden = img.dataset.art !== current.dataset.kit;
      viewer?.setActive(model && onScreen && !document.hidden);
    };

    const select = (tab: HTMLButtonElement, focus = false) => {
      current = tab;
      for (const t of tabs) {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        t.classList.toggle('sel', on);
        const panel = document.getElementById(t.getAttribute('aria-controls') ?? '');
        if (panel) panel.hidden = !on;
      }
      if (focus) tab.focus();
      show();
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (e) => {
        const last = tabs.length - 1;
        const to = { ArrowDown: i + 1, ArrowRight: i + 1, ArrowUp: i - 1, ArrowLeft: i - 1, Home: 0, End: last }[e.key];
        if (to === undefined) return;
        e.preventDefault();
        select(tabs[(to + tabs.length) % tabs.length], true);
      });
    });

    // Load three.js and the model when the bench is within a screen or so of view; run it only while visible.
    let loading = false;
    const load = () => {
      if (loading) return;
      loading = true;
      import('./gunpla/viewer')
        .then(({ mountViewer }) => {
          viewer = mountViewer(canvas, { reducedMotion: reduced });
          show();
        })
        .catch(() => {
          // No WebGL (or the chunk failed): the empty turntable stays.
        });
    };
    new IntersectionObserver((entries) => entries.some((e) => e.isIntersecting) && load(), { rootMargin: '800px 0px' }).observe(bench);
    new IntersectionObserver((entries) => {
      onScreen = entries[entries.length - 1].isIntersecting;
      show();
    }).observe(bench);
    document.addEventListener('visibilitychange', show);
  }
</script>

<style>
  .gunpla {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
  }

  .stage {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .intro {
    padding: 64px 36px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .muted {
    margin: 0;
    max-width: 420px;
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink-muted);
  }

  /* ── The bench: cutting mat, rulers, lamp ── */
  .bench {
    position: relative;
    container-type: size;
    height: 520px;
    overflow: hidden;
    background-color: #22684b;
    background-image:
      linear-gradient(rgba(240, 248, 222, 0.62) 1.5px, transparent 1.5px),
      linear-gradient(90deg, rgba(240, 248, 222, 0.62) 1.5px, transparent 1.5px),
      linear-gradient(rgba(240, 248, 222, 0.3) 1px, transparent 1px),
      linear-gradient(90deg, rgba(240, 248, 222, 0.3) 1px, transparent 1px),
      linear-gradient(rgba(240, 248, 222, 0.1) 1px, transparent 1px),
      linear-gradient(90deg, rgba(240, 248, 222, 0.1) 1px, transparent 1px);
    background-size:
      110px 110px,
      110px 110px,
      22px 22px,
      22px 22px,
      11px 11px,
      11px 11px;
    background-position: 30px 30px;
    box-shadow:
      inset 0 0 0 1px rgba(0, 0, 0, 0.3),
      inset 0 0 80px rgba(0, 0, 0, 0.25);
  }

  .lamp {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(50% 60% at 55% 35%, rgba(255, 250, 230, 0.12), rgba(0, 0, 0, 0) 70%);
  }

  .mruler {
    position: absolute;
    z-index: 2;
    pointer-events: none;
  }

  .mruler.top {
    left: 30px;
    right: 0;
    top: 0;
    height: 30px;
    background-image:
      repeating-linear-gradient(90deg, rgba(243, 237, 176, 0.8) 0 1px, transparent 1px 22px),
      repeating-linear-gradient(90deg, rgba(243, 237, 176, 0.5) 0 1px, transparent 1px 11px);
    background-size:
      100% 9px,
      100% 5px;
    background-repeat: no-repeat;
    background-position:
      0 100%,
      0 100%;
  }

  .mruler.left {
    top: 30px;
    bottom: 0;
    left: 0;
    width: 30px;
    background-image:
      repeating-linear-gradient(180deg, rgba(243, 237, 176, 0.8) 0 1px, transparent 1px 22px),
      repeating-linear-gradient(180deg, rgba(243, 237, 176, 0.5) 0 1px, transparent 1px 11px);
    background-size:
      9px 100%,
      5px 100%;
    background-repeat: no-repeat;
    background-position:
      100% 0,
      100% 0;
  }

  /* ── The 3D model ── */
  .model {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0;
    visibility: hidden;
    cursor: grab;
    touch-action: pan-y;
    transition:
      opacity 0.6s ease,
      visibility 0s linear 0.6s;
  }

  .model[data-dragging] {
    cursor: grabbing;
  }

  [data-view='model'] .model {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.6s ease;
  }

  [data-view='model'] .stand {
    opacity: 0;
  }

  /* ── The turntable, and the halftone pictures of kits without a model ── */
  .stand {
    position: absolute;
    inset: 0;
    transition: opacity 0.5s ease;
  }

  .disc {
    position: absolute;
    left: 52%;
    bottom: 9%;
    width: 50%;
    aspect-ratio: 3.6 / 1;
    transform: translateX(-50%);
    border-radius: 50%;
    background: #1c1f1e;
    box-shadow:
      inset 0 -6px 0 #0d0f0e,
      0 0 0 1px #3d4441,
      0 18px 30px -10px rgba(0, 0, 0, 0.6);
  }

  /* The ticks turn in a square plane, squashed to the disc's ellipse, so they stay on the rim as they spin. */
  .plane {
    position: absolute;
    left: 8%;
    right: 8%;
    top: 50%;
    aspect-ratio: 1;
    transform: translateY(-50%) scaleY(calc(1 / 3.6));
  }

  .ticks {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: repeating-conic-gradient(#8a918d 0 1.5deg, transparent 1.5deg 15deg);
    mask-image: radial-gradient(closest-side, transparent 82%, #000 84%);
    animation: spin 12s linear infinite;
  }

  @keyframes spin {
    to {
      transform: rotate(1turn);
    }
  }

  .kit-art {
    position: absolute;
    left: 52%;
    /* Feet at the middle of the disc: the disc sits 9% up and is a 3.6:1 ellipse half the bench wide. */
    bottom: calc(9cqh + 50cqw / 7.2);
    height: 76cqh;
    width: auto;
    max-width: 92cqw;
    object-fit: contain;
    object-position: 50% 100%;
    transform: translateX(-50%);
    filter: drop-shadow(0 14px 18px rgba(0, 0, 0, 0.35));
    animation: art-in 0.45s ease both;
  }

  .kit-art[hidden] {
    display: none;
  }

  .kit-art.next {
    opacity: 0.9;
  }

  @keyframes art-in {
    from {
      opacity: 0;
      translate: 0 8px;
    }
  }

  /* ── Kit details under the bench ── */
  .card {
    padding: 22px 28px 26px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    border-top: 1px solid var(--rule);
  }

  .card[hidden] {
    display: none;
  }

  .card-head {
    grid-column: 1 / -1;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  .card-title {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .code {
    font: 500 12px/1.2 var(--font-mono);
    color: var(--ink-muted);
  }

  .name {
    font-size: 28px;
    font-stretch: 112%;
  }

  .card .eyebrow {
    font-size: 10.5px;
  }

  .val {
    margin-top: 6px;
    font-size: 15px;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    height: 22px;
    padding: 0 8px;
    border-radius: 999px;
    font: 500 10.5px/1 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .p-built {
    background: #1c2b55;
    color: #b9c8ff;
  }

  .p-next {
    background: #3a3218;
    color: #f2d27a;
  }

  /* ── Kit list ── */
  .kits {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-top: 8px;
  }

  .krow {
    all: unset;
    box-sizing: border-box;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto 22px;
    gap: 16px;
    align-items: center;
    width: 100%;
    padding: 18px 14px 18px 12px;
    border-radius: 10px;
    cursor: pointer;
    color: var(--ink);
    transition: background 0.2s;
  }

  .krow:hover {
    background: var(--tint-hover);
  }

  .krow.sel {
    background: var(--tint);
  }

  .krow:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 1px;
  }

  .ktext {
    display: flex;
    flex-direction: column;
  }

  .kname {
    font: 500 17px/1.3 var(--font-sans);
  }

  .kmeta {
    font: 400 14px/1.45 var(--font-sans);
    color: var(--ink-muted);
    margin-top: 3px;
  }

  .kkind {
    font: 500 11px/1 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .kkind.built {
    color: #b9c8ff;
  }

  .kkind.next {
    color: #f2d27a;
  }

  .krow .arrow {
    opacity: 0;
    transform: translateX(-4px);
    transition:
      opacity 0.2s,
      transform 0.2s;
  }

  .krow.sel .arrow {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .ticks,
    .kit-art {
      animation: none;
    }
  }

  @media (max-width: 1023px) {
    .gunpla {
      grid-template-columns: minmax(0, 1fr);
    }

    .vline {
      border-left: 0;
    }

    .intro {
      order: -1;
      padding-bottom: 32px;
    }
  }

  @media (max-width: 760px) {
    .intro {
      padding: 40px 16px 28px;
    }

    .bench {
      height: 420px;
    }

    .card {
      padding: 20px 16px 24px;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    .card > div:last-child {
      grid-column: 1 / -1;
    }
  }
</style>
