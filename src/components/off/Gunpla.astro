---
// Phase 3 fills this in: the cutting-mat stage, the kit viewer and the kit list.
---

<section class="band gunpla">
  <div>
    <div class="bench" aria-hidden="true"></div>
  </div>
  <div class="intro vline">
    <span class="eyebrow">Gunpla</span>
    <h2 class="display h2">Kits I've built</h2>
    <p class="muted">Master Grades, mostly. The finished ones are on my shelf, the rest are next in line.</p>
  </div>
  <span class="cross cl"></span><span class="cross cr"></span>
</section>

<style>
  .gunpla {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
  }

  .intro {
    padding: 64px 40px;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .muted {
    margin: 0;
    max-width: 420px;
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink-muted);
  }

  .bench {
    height: 520px;
    background-color: #22684b;
    background-image:
      linear-gradient(rgba(240, 248, 222, 0.62) 1.5px, transparent 1.5px),
      linear-gradient(90deg, rgba(240, 248, 222, 0.62) 1.5px, transparent 1.5px),
      linear-gradient(rgba(240, 248, 222, 0.3) 1px, transparent 1px),
      linear-gradient(90deg, rgba(240, 248, 222, 0.3) 1px, transparent 1px),
      linear-gradient(rgba(240, 248, 222, 0.1) 1px, transparent 1px),
      linear-gradient(90deg, rgba(240, 248, 222, 0.1) 1px, transparent 1px);
    background-size:
      110px 110px,
      110px 110px,
      22px 22px,
      22px 22px,
      11px 11px,
      11px 11px;
    background-position: 30px 30px;
    box-shadow:
      inset 0 0 0 1px rgba(0, 0, 0, 0.3),
      inset 0 0 80px rgba(0, 0, 0, 0.25);
  }

  @media (max-width: 1023px) {
    .gunpla {
      grid-template-columns: minmax(0, 1fr);
    }

    .vline {
      border-left: 0;
    }

    .intro {
      order: -1;
      padding-bottom: 32px;
    }
  }

  @media (max-width: 760px) {
    .intro {
      padding: 40px 16px 28px;
    }

    .bench {
      height: 380px;
    }
  }
</style>
