---
import { letterboxd } from '../../data/films';
import { getFilmStats } from '../../data/film-stats';
import { getRecentFilms, MIN_RATING } from '../../data/recent-films';
import { stars } from '../../data/letterboxd';
import { discPose, RENDER_RADIUS, LOAD_RADIUS } from './discs';

// Films: the latest Letterboxd films rated 3.5+ as CDs, after Ravi Klaassens' A24
// concept site. Each disc turns three-quarters toward you: a landscape still
// printed around a clear hub (frosted ring, metallic ring, clear lip, in A24's
// proportions), a polished metal rim, a silver edge and a soft strip-light
// gloss. Arrows, keys, a click on a disc, a drag or a sideways
// swipe move the row. Only discs near the focus are drawn, and only those load
// their art. The layout renders server-side, so it reads correctly before (or
// without) the script.
const stats = await getFilmStats();
const { films } = await getRecentFilms();
const flaps = [...String(stats.total)];
const first = films[0];
const pad = (n: number) => String(n).padStart(2, '0');
const day = (iso: string) => new Date(`${iso}T12:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' });
const meta = films.map((f) => ({
  title: f.title,
  director: f.director,
  href: f.href,
  stars: stars(f.rating ?? 0),
  rating: f.rating,
  watched: day(f.watched),
}));

const ssrTransform = (d: number) => {
  const p = discPose(d);
  return `translate3d(calc(${p.x}px * var(--u)),calc(${p.y}px * var(--u)),calc(${p.z}px * var(--u))) scale(${p.scale})`;
};
---

<section class="band films" data-films={JSON.stringify(meta)}>
  <div class="intro">
    <span class="eyebrow">Films</span>
    <h2 class="display h2">I watch a lot of films</h2>
    <p class="muted">Every one gets logged and rated on Letterboxd. These are the latest that earned {MIN_RATING} stars or more.</p>
    <div class="counter">
      <span class="flap-row" aria-hidden="true">
        {flaps.map((ch) => <span class="flap count-flap">{ch}</span>)}
      </span>
      <span class="mono count-label"><span class="sr-only">{stats.total} </span>films logged, all time</span>
      {stats.thisYear !== null && <span class="this-year">{stats.thisYear} this year</span>}
    </div>
    <a class="lbx" href={letterboxd.profile}>
      <span class="dots" aria-hidden="true"><i class="o"></i><i class="g"></i><i class="b"></i></span>
      {letterboxd.user} on Letterboxd
    </a>
  </div>

  <div class="stage vline">
    <div class="player" role="region" aria-roledescription="carousel" aria-label="Recently rated films">
      {
        films.map((f, i) => {
          const p = discPose(i);
          const load = i <= LOAD_RADIUS;
          return (
            <button
              type="button"
              class:list={['cd', { focus: i === 0 }]}
              data-i={i}
              aria-label={`${f.title} (${f.year})`}
              tabindex={i === 0 ? 0 : -1}
              hidden={i >= RENDER_RADIUS}
              style={`transform:${ssrTransform(i)};opacity:${p.opacity};z-index:${p.order}`}
            >
              <span class="disc">
                <span class="edge e2" />
                <span class="edge e1" />
                <span class="face">
                  <span class="spin">
                    <img
                      class="art"
                      src={load ? (f.still ?? f.poster ?? undefined) : undefined}
                      data-src={f.still ?? f.poster ?? undefined}
                      alt=""
                      width="1200"
                      height="675"
                      loading={i < 3 ? 'eager' : 'lazy'}
                      decoding="async"
                      referrerpolicy="no-referrer"
                      draggable="false"
                    />
                  </span>
                  <span class="gloss" />
                  <span class="rim" />
                  <span class="matrix" />
                  <span class="hub" />
                </span>
                <span class="halo" />
              </span>
            </button>
          );
        })
      }
    </div>
    <div class="info">
      <div class="now" aria-live="polite">
        <a class="display now-title" href={meta[0].href} data-title>{first.title}</a>
        <span class="now-meta" data-director-line hidden={!first.director}><span class="mono label">Directed by</span> <span data-director>{first.director}</span></span>
      </div>
      <div class="side">
        <span class="mono now-pos">
          <span class="stars" data-stars aria-label={`${first.rating} stars`}>{meta[0].stars}</span> · <span data-watched>{meta[0].watched}</span> · <span data-pos>{pad(1)} / {pad(films.length)}</span>
        </span>
        <div class="ctrls">
          <button type="button" class="ctrl" data-step="-1" aria-label="Previous film">
            <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M10 3 5 8l5 5" /></svg>
          </button>
          <button type="button" class="ctrl" data-step="1" aria-label="Next film">
            <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="m6 3 5 5-5 5" /></svg>
          </button>
        </div>
      </div>
    </div>
  </div>
  <span class="cross cl"></span><span class="cross cr"></span>
</section>

<style>
  .films {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
  }

  .intro {
    padding: 64px 40px;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .muted {
    margin: 0;
    max-width: 400px;
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink-muted);
  }

  .counter {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 8px;
  }

  .count-flap {
    width: 40px;
    height: 56px;
    font: 500 32px/1 var(--font-display);
  }

  .count-label {
    font-size: 12px;
    color: var(--ink-muted);
  }

  .this-year {
    font-size: 15px;
    color: var(--ink-2);
  }

  .lbx {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 40px;
    padding: 0 14px 0 12px;
    border-radius: 999px;
    background: var(--seg-bg);
    box-shadow: inset 0 0 0 1px var(--rail);
    color: var(--ink);
    text-decoration: none;
    font: 500 14px/1 var(--font-sans);
  }

  .lbx:hover {
    color: #fff;
    box-shadow: inset 0 0 0 1px var(--ink-muted);
  }

  .dots {
    display: inline-flex;
  }

  .dots i {
    display: block;
    width: 13px;
    height: 13px;
    margin-left: -3px;
    border-radius: 50%;
    mix-blend-mode: screen;
  }

  .dots .o {
    margin-left: 0;
    background: #ff8000;
  }

  .dots .g {
    background: #00e054;
  }

  .dots .b {
    background: #40bcf4;
  }

  .stage {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .player {
    --u: 1;
    --disc: 410px;
    position: relative;
    height: 540px;
    overflow: hidden;
    perspective: 1400px;
    background: radial-gradient(70% 70% at 50% 46%, #1b1d22, #0b0c0e 78%);
    cursor: grab;
    touch-action: pan-y;
    user-select: none;
  }

  /* Paper-ish grain over the stage: a static texture, no blend mode, so it costs nothing per frame. */
  .player::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 200;
    pointer-events: none;
    background: url('/textures/noise.png');
    background-size: 128px 128px;
    opacity: 0.7;
  }

  .player.dragging {
    cursor: grabbing;
  }

  .cd {
    all: unset;
    position: absolute;
    left: 50%;
    top: 52%;
    width: var(--disc);
    height: var(--disc);
    margin: calc(var(--disc) / -2) 0 0 calc(var(--disc) / -2);
    border-radius: 50%;
    cursor: pointer;
    transition:
      transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1),
      opacity 0.4s ease;
  }

  .cd[hidden] {
    display: none;
  }

  .player.dragging .cd {
    transition: none;
  }

  .cd:focus-visible {
    outline: none;
  }

  /*
   * Every disc turns three-quarters toward you at the same angle, as A24's gallery does
   * (rotated −30° on X and Y): the top leans back a little and the right side comes forward.
   * The edge layers sit behind the face for thickness.
   */
  .disc {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    transform: rotateX(30deg) rotateY(-30deg);
  }

  .edge,
  .face {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    -webkit-mask-image: radial-gradient(circle closest-side, transparent 0 14%, #000 calc(14% + 0.6px));
    mask-image: radial-gradient(circle closest-side, transparent 0 14%, #000 calc(14% + 0.6px));
  }

  /* A mirror-like silver edge: light and dark bands as the rim turns away from the light. */
  .edge {
    background: conic-gradient(from 200deg, #f4f6f9, #9aa1ab 18%, #e9ecf0 32%, #7f8792 50%, #f1f3f6 68%, #a3aab3 84%, #f4f6f9);
  }

  .e1 {
    transform: translateZ(-3px);
  }

  .e2 {
    transform: translateZ(-6px);
    filter: brightness(0.6);
  }

  .face {
    overflow: hidden;
    background: #0c0c0e;
  }

  .spin {
    position: absolute;
    inset: 0;
  }

  .cd.focus .spin {
    animation: spin 28s linear infinite;
    will-change: transform;
  }

  .art {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(1.05) contrast(1.06) brightness(0.94);
    pointer-events: none;
  }

  /*
   * Gloss: the soft strip-light highlight across the printed face (A24 lights the disc with a
   * long top strip), a faint clear band at the very rim, and print texture.
   */
  .gloss {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(118deg, transparent 30%, rgba(255, 255, 255, 0.15) 43%, rgba(255, 255, 255, 0.05) 50%, transparent 60%),
      url('/textures/noise.png');
    background-size:
      100% 100%,
      128px 128px;
    opacity: 0.95;
  }

  /* The outer rim: a polished metal band around the printed face, brightest where it faces the light. */
  .rim {
    position: absolute;
    inset: 0;
    background: conic-gradient(from 210deg, #f7f8fa, #a9afb8 14%, #e6e9ee 28%, #858c97 46%, #f2f4f7 62%, #9da4ae 80%, #f7f8fa);
    -webkit-mask-image: radial-gradient(circle closest-side, transparent 0 93.2%, #000 93.6% 99.6%, transparent 100%);
    mask-image: radial-gradient(circle closest-side, transparent 0 93.2%, #000 93.6% 99.6%, transparent 100%);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.5);
    border-radius: 50%;
  }

  /* The metallic "matrix" ring of the hub, brushed silver. */
  .matrix {
    position: absolute;
    inset: 0;
    background: conic-gradient(from 30deg, #cfd4db, #f4f6f9, #aeb4bd, #eef1f5, #b9bec7, #f1f3f6, #cfd4db);
    -webkit-mask-image: radial-gradient(circle closest-side, transparent 0 17.4%, #000 17.6% 21.2%, transparent 21.4%);
    mask-image: radial-gradient(circle closest-side, transparent 0 17.4%, #000 17.6% 21.2%, transparent 21.4%);
  }

  /* The clear hub around it: a frosted inner ring, then clear plastic with a bright lip. */
  .hub {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle closest-side,
      transparent 0 14%,
      rgba(238, 240, 245, 0.88) 14.1% 17.4%,
      transparent 17.5% 21.4%,
      rgba(255, 255, 255, 0.16) 21.5% 23.4%,
      rgba(255, 255, 255, 0.6) 23.5% 24.1%,
      rgba(0, 0, 0, 0.25) 24.2% 24.5%,
      transparent 24.7%
    );
  }

  /* The face is masked (for the hole), which would clip an outline, so focus gets its own ring. */
  .halo {
    position: absolute;
    inset: -8px;
    border-radius: 50%;
    transform: translateZ(1px);
    pointer-events: none;
  }

  .cd:focus-visible .halo {
    box-shadow: 0 0 0 2px var(--focus);
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .info {
    padding: 18px 28px 22px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    border-top: 1px solid var(--rule);
  }

  .now {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }

  .now-title {
    font-size: 26px;
    font-stretch: 112%;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .now-title:hover {
    color: var(--link);
  }

  .now-meta {
    font-size: 14px;
    color: var(--ink-2);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .label {
    font-size: 10.5px;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--graphite);
  }

  .side {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-shrink: 0;
  }

  .now-pos {
    font-size: 12.5px;
    color: var(--ink-muted);
  }

  .stars {
    color: var(--chip-yellow);
  }

  .ctrls {
    display: flex;
    gap: 8px;
  }

  .ctrl {
    all: unset;
    box-sizing: border-box;
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--seg-bg);
    box-shadow: inset 0 0 0 1px var(--rail);
    color: var(--ink);
    cursor: pointer;
  }

  .ctrl:hover {
    box-shadow: inset 0 0 0 1px var(--ink-muted);
  }

  .ctrl:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .ctrl[aria-disabled='true'] {
    opacity: 0.4;
    cursor: default;
  }

  @media (max-width: 1023px) {
    .films {
      grid-template-columns: minmax(0, 1fr);
    }

    .intro {
      padding-bottom: 32px;
    }

    .stage {
      border-left: 0;
      border-top: 1px solid var(--rule);
    }
  }

  @media (max-width: 760px) {
    .intro {
      padding: 40px 16px 28px;
      gap: 16px;
    }

    .player {
      --u: 0.68;
      --disc: 280px;
      height: 380px;
    }

    .info {
      padding: 14px 16px 16px;
      flex-wrap: wrap;
    }

    .now-title {
      font-size: 20px;
    }

    .side {
      width: 100%;
      justify-content: space-between;
    }
  }
</style>

<script>
  import { discPose, discTransform, RENDER_RADIUS, LOAD_RADIUS, STEP_X } from './discs';

  type Meta = { title: string; director: string | null; href: string; stars: string; rating: number | null; watched: string };
  const root = document.querySelector<HTMLElement>('[data-films]');
  if (root) {
    const films: Meta[] = JSON.parse(root.dataset.films ?? '[]');
    const player = root.querySelector<HTMLElement>('.player')!;
    const discs = [...root.querySelectorAll<HTMLButtonElement>('.cd')];
    const arts = discs.map((d) => d.querySelector<HTMLImageElement>('.art')!);
    const title = root.querySelector<HTMLAnchorElement>('[data-title]')!;
    const director = root.querySelector<HTMLElement>('[data-director]')!;
    const directorLine = root.querySelector<HTMLElement>('[data-director-line]')!;
    const starsEl = root.querySelector<HTMLElement>('[data-stars]')!;
    const watched = root.querySelector<HTMLElement>('[data-watched]')!;
    const pos = root.querySelector<HTMLElement>('[data-pos]')!;
    const steps = [...root.querySelectorAll<HTMLButtonElement>('[data-step]')];
    const n = discs.length;
    const pad = (v: number) => String(v).padStart(2, '0');
    let unit = 1;
    let focus = 0;

    const readUnit = () => {
      unit = parseFloat(getComputedStyle(player).getPropertyValue('--u')) || 1;
    };

    /** Lay out the discs around a (possibly fractional) position. Far discs aren't drawn at all. */
    const render = (at: number) => {
      discs.forEach((el, i) => {
        const d = i - at;
        const far = Math.abs(d) >= RENDER_RADIUS;
        if (el.hidden !== far) el.hidden = far;
        if (far) return;
        const p = discPose(d);
        el.style.transform = discTransform(d, unit);
        el.style.opacity = p.opacity.toFixed(3);
        el.style.zIndex = String(p.order);
        el.style.pointerEvents = p.visible ? '' : 'none';
      });
    };

    /** Load the art for discs near the focus, so the next few are ready and the rest stay unfetched. */
    const loadNear = () => {
      arts.forEach((img, i) => {
        if (Math.abs(i - focus) <= LOAD_RADIUS && !img.getAttribute('src') && img.dataset.src) img.src = img.dataset.src;
      });
    };

    const go = (i: number, moveFocus = false) => {
      focus = Math.min(n - 1, Math.max(0, i));
      player.classList.remove('dragging');
      render(focus);
      loadNear();
      discs.forEach((el, k) => {
        el.classList.toggle('focus', k === focus);
        el.tabIndex = k === focus ? 0 : -1;
      });
      const f = films[focus];
      title.textContent = f.title;
      title.href = f.href;
      director.textContent = f.director ?? '';
      directorLine.hidden = !f.director;
      starsEl.textContent = f.stars;
      starsEl.setAttribute('aria-label', `${f.rating} stars`);
      watched.textContent = f.watched;
      pos.textContent = `${pad(focus + 1)} / ${pad(n)}`;
      steps[0].setAttribute('aria-disabled', String(focus === 0));
      steps[1].setAttribute('aria-disabled', String(focus === n - 1));
      if (moveFocus) discs[focus].focus({ preventScroll: true });
    };

    steps.forEach((b) => b.addEventListener('click', () => go(focus + Number(b.dataset.step))));

    // Drag or flick along the row; a press that barely moves is a click.
    let dragging = false;
    let moved = false;
    let startX = 0;
    let at = 0;
    let lastX = 0;
    let lastT = 0;
    let velocity = 0;
    let frame = 0;
    player.addEventListener('pointerdown', (e) => {
      if (e.button !== 0) return;
      dragging = true;
      moved = false;
      startX = lastX = e.clientX;
      at = focus;
      lastT = performance.now();
      velocity = 0;
    });
    player.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      const dx = e.clientX - startX;
      if (!moved && Math.abs(dx) < 6) return;
      if (!moved) {
        moved = true;
        player.setPointerCapture(e.pointerId);
        player.classList.add('dragging');
      }
      const step = STEP_X * unit;
      at = Math.min(n - 0.6, Math.max(-0.4, focus - dx / step));
      const now = performance.now();
      velocity = 0.7 * velocity + 0.3 * (-(e.clientX - lastX) / step / (Math.max(1, now - lastT) / 1000));
      lastX = e.clientX;
      lastT = now;
      if (!frame) frame = requestAnimationFrame(() => ((frame = 0), render(at)));
    });
    const release = () => {
      if (!dragging) return;
      dragging = false;
      if (moved) go(Math.round(Math.min(n - 1, Math.max(0, at + velocity * 0.18))));
    };
    player.addEventListener('pointerup', release);
    player.addEventListener('pointercancel', release);

    discs.forEach((el, i) => {
      el.addEventListener('click', (e) => {
        if (moved) {
          e.preventDefault();
          moved = false;
          return;
        }
        if (i !== focus) go(i);
      });
      el.addEventListener('keydown', (e) => {
        const to = { ArrowLeft: focus - 1, ArrowRight: focus + 1, Home: 0, End: n - 1 }[e.key];
        if (to === undefined) return;
        e.preventDefault();
        go(to, true);
      });
    });

    // A sideways trackpad swipe (or shift + wheel) steps through; vertical scrolling stays with the page.
    let lastWheel = 0;
    player.addEventListener(
      'wheel',
      (e) => {
        const sideways = Math.abs(e.deltaX) > Math.abs(e.deltaY) ? e.deltaX : e.shiftKey ? e.deltaY : 0;
        if (!sideways) return;
        e.preventDefault();
        const now = performance.now();
        if (now - lastWheel < 380 || Math.abs(sideways) < 8) return;
        lastWheel = now;
        go(focus + (sideways > 0 ? 1 : -1));
      },
      { passive: false },
    );

    window.addEventListener('resize', () => {
      readUnit();
      render(focus);
    });
    readUnit();
    go(0);
  }
</script>
