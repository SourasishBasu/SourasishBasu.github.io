---
// The koi pond band in the Off the clock footer. The engine loads only when
// the pond is about to scroll into view; tap the water to drop food.
---

<div class="band pond" role="img" aria-label="A koi pond drawn in ASCII, with lily pads">
  <canvas class="pond-canvas" aria-hidden="true"></canvas>
</div>

<style>
  .pond {
    height: 320px;
    overflow: hidden;
    background: #06070c;
  }

  .pond-canvas {
    display: block;
    width: 100%;
    height: 100%;
    font-family: var(--font-mono);
    cursor: pointer;
  }

  @media (max-width: 760px) {
    .pond {
      height: 260px;
    }
  }
</style>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('.pond-canvas');
  if (canvas) {
    const io = new IntersectionObserver(
      async ([entry]) => {
        if (!entry?.isIntersecting) return;
        io.disconnect();
        const { mountPond } = await import('./pond');
        mountPond(canvas);
      },
      { rootMargin: '400px 0px' },
    );
    io.observe(canvas);
  }
</script>
